# ---- Telegram ----------------------------------------------------------
# Bot token from @BotFather
TOKEN_API_BOT=

# Comma-separated numeric Telegram user ids allowed to run admin commands
ADMIN_IDS=

# ---- Storage -----------------------------------------------------------
# Redis holds FSM state only. host:port or a full redis:// URL.
REDIS=redis:6379

# SQLite file holding all history. Must be on a persistent volume.
DB_PATH=/data/numbers.sqlite3

# ---- Network -----------------------------------------------------------
# HTTP proxy for Telegram and OpenRouter. Both are blocked without it on this
# network. On the server the xray container serves an HTTP inbound on 10809.
# LM Studio is on the LAN and is never routed through this.
HTTP_PROXY_URL=http://xray:10809

# ---- LLM (encouragement phrases) --------------------------------------
# OpenRouter key, used only when LM Studio is unreachable.
API_KEY_LLM=

# LM Studio on the author's PC. Tried first: free, on the LAN, often off.
LMSTUDIO_BASE_URL=http://<lm-studio-host>:1234/v1
LMSTUDIO_MODEL=gigachat3.1-10b-a1.8b
LMSTUDIO_TIMEOUT=60

# OpenRouter fallback. gemma-3-12b-it was picked by comparing candidate cheap
# models on actual Russian output; qwen3.7-flash is a reasoning model and
# returns a null `content`, so do not use it here.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-3-12b-it
OPENROUTER_TIMEOUT=30

# Phrase pool shape
PHRASE_POOL_TARGET=10
PHRASE_POOL_MAX=40
PHRASE_MAX_LENGTH=160
PHRASE_MAX_EMOJI=6
PHRASE_GENERATE_RETRIES=3

# ---- Limits ------------------------------------------------------------
THROTTLE_MESSAGES=5
THROTTLE_WINDOW_SECONDS=3
MAX_INPUT_LENGTH=200
SESSION_IDLE_TIMEOUT_SECONDS=1800

# ---- Admin dashboard ---------------------------------------------------
# The dashboard refuses to start without a password.
ADMIN_WEB_USER=admin
ADMIN_WEB_PASSWORD=
# Port published on the LAN interface only (see docker-compose.ubuser.yml)
ADMIN_WEB_PORT=8080
BALANCE_CACHE_SECONDS=300

# ---- Logging -----------------------------------------------------------
LOG_LEVEL=INFO
